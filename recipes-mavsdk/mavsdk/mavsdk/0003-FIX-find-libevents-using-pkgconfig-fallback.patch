From a197162233428fd3f6469b8905d1f02c335c1220 Mon Sep 17 00:00:00 2001
From: Patrick Oetken <patrick@wargdrones.com>
Date: Thu, 2 Apr 2026 15:02:56 +0200
Subject: [PATCH] FIX: find libevents using pkgconfig fallback
Upstream-Status: Inappropriate [oe-specific]

---
 src/MAVSDKConfig.cmake.in |  7 ++++++-
 src/mavsdk/CMakeLists.txt | 11 +++++++++--
 2 files changed, 15 insertions(+), 3 deletions(-)

diff --git a/src/MAVSDKConfig.cmake.in b/src/MAVSDKConfig.cmake.in
index aee2492b..013cf21a 100644
--- a/src/MAVSDKConfig.cmake.in
+++ b/src/MAVSDKConfig.cmake.in
@@ -12,7 +12,12 @@ if(NOT @BUILD_SHARED_LIBS@)
     find_dependency(tinyxml2 REQUIRED)
     find_dependency(mav REQUIRED)
     find_dependency(LibLZMA REQUIRED)
-    find_dependency(LibEvents REQUIRED)
+
+    find_dependency(libevents QUIET)
+    if(NOT libevents_FOUND)
+        include(FindPkgConfig)
+        pkg_check_modules(LIBEVENT REQUIRED IMPORTED_TARGET libevent)
+    endif()
 
     if(@BUILD_MAVSDK_SERVER@)
         find_dependency(gRPC)
diff --git a/src/mavsdk/CMakeLists.txt b/src/mavsdk/CMakeLists.txt
index e3594830..0d1c25fc 100644
--- a/src/mavsdk/CMakeLists.txt
+++ b/src/mavsdk/CMakeLists.txt
@@ -10,8 +10,15 @@ pkg_check_modules(JSONCPP REQUIRED IMPORTED_TARGET jsoncpp)
 
 find_package(tinyxml2 REQUIRED)
 
-find_package(libevents REQUIRED)
-find_package(picosha2 REQUIRED)
+find_package(libevents QUIET)
+if(NOT libevents_FOUND)
+    pkg_check_modules(LIBEVENT REQUIRED IMPORTED_TARGET libevent)
+
+    if(NOT TARGET LibEvents::LibEvents)
+        add_library(LibEvents::LibEvents INTERFACE IMPORTED)
+        target_link_libraries(LibEvents::LibEvents INTERFACE PkgConfig::LIBEVENT)
+    endif()
+endif()
 find_package(mav REQUIRED)
 
 target_link_libraries(mavsdk
