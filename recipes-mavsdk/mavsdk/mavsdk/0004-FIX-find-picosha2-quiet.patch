From 4b5d6dad79155e1b9b2fd4520af7152132b80677 Mon Sep 17 00:00:00 2001
From: Patrick Oetken <patrick@wargdrones.com>
Date: Thu, 2 Apr 2026 15:03:30 +0200
Subject: [PATCH] FIX: find picosha2 quiet

---
 src/MAVSDKConfig.cmake.in | 2 +-
 src/mavsdk/CMakeLists.txt | 3 +++
 2 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/MAVSDKConfig.cmake.in b/src/MAVSDKConfig.cmake.in
index 013cf21a..430b133e 100644
--- a/src/MAVSDKConfig.cmake.in
+++ b/src/MAVSDKConfig.cmake.in
@@ -8,7 +8,7 @@ if(NOT @BUILD_SHARED_LIBS@)
 
     find_dependency(Threads REQUIRED)
     find_dependency(jsoncpp REQUIRED)
-    find_dependency(picosha2 REQUIRED)
+    find_dependency(picosha2 QUIET)
     find_dependency(tinyxml2 REQUIRED)
     find_dependency(mav REQUIRED)
     find_dependency(LibLZMA REQUIRED)
diff --git a/src/mavsdk/CMakeLists.txt b/src/mavsdk/CMakeLists.txt
index 0d1c25fc..2f173dcc 100644
--- a/src/mavsdk/CMakeLists.txt
+++ b/src/mavsdk/CMakeLists.txt
@@ -19,6 +19,9 @@ if(NOT libevents_FOUND)
         target_link_libraries(LibEvents::LibEvents INTERFACE PkgConfig::LIBEVENT)
     endif()
 endif()
+
+# picosha2 is header-only and currently not linked directly in this target.
+find_package(picosha2 QUIET)
 find_package(mav REQUIRED)
 
 target_link_libraries(mavsdk
